# Runtime environment: development, test, preview or production.
HSE_APP_ENV=development
HSE_RELEASE_SHA=local-development
HSE_DEPLOYMENT_ID=local-development

# Required everywhere. Use at least 32 random bytes and never commit a real secret.
HSE_SESSION_SECRET=replace-with-a-long-random-secret-of-at-least-32-characters

# Persist an independent credential signing key. Required in production; configure
# explicitly in development/test to issue and authenticate signed credentials.
# Session-secret rotation never changes this key. Never commit real key values.
HSE_CREDENTIAL_SIGNING_SECRET=replace-with-a-persisted-random-credential-signing-key
# Optional JSON array of retained old credential keys (max 8, each 32-512 characters).
# On rotation, keep prior keys here while their credentials must remain verifiable.
# Removing a key makes its signed credentials unavailable; it does not re-sign history.
HSE_CREDENTIAL_SIGNING_PREVIOUS_SECRETS=[]

# Authentication pepper is separate from the session secret in production.
# Development/test may temporarily fall back to HSE_SESSION_SECRET, but an explicit
# local value is recommended whenever registration data already exists.
HSE_AUTH_PEPPER=replace-with-a-separate-long-random-auth-pepper

# Database. Local development uses embedded PostgreSQL-compatible PGlite.
# Preview and production must use postgres with a private DATABASE_URL.
HSE_DATABASE_DRIVER=pglite
HSE_PGLITE_DATA_DIR=.data/postgres
DATABASE_URL=

# Development/test-only delivery sandbox for registration email and phone OTP.
# Preview and production reject this adapter even when the flag is true.
HSE_ENABLE_AUTH_SANDBOX=false
HSE_AUTH_SANDBOX_ACCESS_KEY=replace-with-a-local-access-key-of-at-least-16-characters

# Foundation-only Worker login adapter. Keep disabled outside isolated testing.
HSE_ENABLE_WORKER_DEMO_AUTH=false
HSE_WORKER_DEMO_EMAIL=worker@example.com
HSE_WORKER_DEMO_PASSWORD=replace-with-a-strong-local-password
HSE_WORKER_DEMO_NAME=Demo Worker
HSE_WORKER_DEMO_ID=HSE-WRK-000001

# Demonstration dashboard records for isolated workflow testing only.
HSE_USE_WORKER_DEMO_DATA=false

# Demonstrates the correction-request path for identity-verified profile fields.
HSE_DEMO_PROFILE_IDENTITY_LOCKED=false

# One-time import path for profile JSON created before the database migration.
HSE_LEGACY_PROFILE_STORAGE_DIR=.data/worker-profiles
HSE_IMPORT_OVERWRITE=false


# Scheduling emails remain unavailable until these values are configured.
# Use a verified sender domain. Production requires a clean HTTPS origin.
HSE_PUBLIC_BASE_URL=
HSE_OTP_EMAIL_API_KEY=
HSE_OTP_EMAIL_FROM=

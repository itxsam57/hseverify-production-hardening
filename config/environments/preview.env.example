HSE_APP_ENV=preview
HSE_RELEASE_SHA=replace-with-git-commit-sha
HSE_DEPLOYMENT_ID=replace-with-preview-deployment-id
HSE_SESSION_SECRET=inject-from-preview-secret-store
HSE_DATABASE_DRIVER=postgres
DATABASE_URL=postgresql://inject-from-preview-secret-store
HSE_ENABLE_WORKER_DEMO_AUTH=false
HSE_USE_WORKER_DEMO_DATA=false
HSE_DEMO_PROFILE_IDENTITY_LOCKED=false

HSE_APP_ENV=production
HSE_RELEASE_SHA=replace-with-approved-git-commit-sha
HSE_DEPLOYMENT_ID=replace-with-production-deployment-id
HSE_SESSION_SECRET=inject-from-production-secret-store
HSE_DATABASE_DRIVER=postgres
DATABASE_URL=postgresql://inject-from-production-secret-store
HSE_ENABLE_WORKER_DEMO_AUTH=false
HSE_USE_WORKER_DEMO_DATA=false
HSE_DEMO_PROFILE_IDENTITY_LOCKED=false

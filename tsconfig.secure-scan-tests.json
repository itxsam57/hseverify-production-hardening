{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "strict": true,
    "skipLibCheck": true,
    "outDir": ".secure-scan-test-dist",
    "rootDir": "src/lib",
    "types": ["node"],
    "lib": ["ES2022", "DOM"],
    "noEmitOnError": true

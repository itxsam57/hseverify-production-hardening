    "module": "Node16",
    "moduleResolution": "Node16",
    "strict": true,
    "skipLibCheck": true,
    "outDir": ".email-delivery-test-dist",
    "rootDir": "src/lib",
    "types": ["node"],
    "lib": ["ES2022"],
    "noEmitOnError": true
  },
  "include": [

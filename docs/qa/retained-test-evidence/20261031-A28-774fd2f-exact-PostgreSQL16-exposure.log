r_id OR\\\\\\\\n     source_attempt.lease_id IS DISTINCT FROM NEW.lease_id OR\\\\\\\\n     source_attempt.outcome <> ''''running'''' THEN\\\\\\\\n    RAISE EXCEPTION USING\\\\\\\\n      ERRCODE = ''''23514'''',\\\\\\\\n      MESSAGE = ''''Email delivery attempt must bind to the active outbox attempt.'''';\\\\\\\\n  END IF;\\\\\\\\n\\\\\\\\n  IF source_job.job_id IS NULL OR\\\\\\\\n     source_job.job_type NOT IN (''''email.delivery.foundation'''',''''email.interview.scheduled'''',''''email.interview.reminder'''',''''email.assurance.event'''') OR\\\\\\\\n     source_job.status <> ''''leased'''' OR\\\\\\\\n     source_job.lease_id IS DISTINCT FROM NEW.lease_id OR\\\\\\\\n     source_job.worker_id IS DISTINCT FROM NEW.worker_id OR\\\\\\\\n     source_job.lease_expires_at <= clock_timestamp() THEN\\\\\\\\n    RAISE EXCEPTION USING\\\\\\\\n      ERRCODE = ''''23514'''',\\\\\\\\n      MESSAGE = ''''Email delivery attempt requires the currently owned unexpired outbox lease.'''';\\\\\\\\n  END IF;\\\\\\\\n\\\\\\\\n\\\\\\\\n  IF (delivery.delivery_type IN (''''interview.scheduled'''',''''interview.reminder'''',''''evidence.submitted'''',''''evidence.reviewed'''',''''evidence.unable'''',''''evidence.escalated'''',''''evidence.returned'''',''''evidence.additional.requested'''',''''decision.recorded'''',''''credential.issued'''',''''appeal.submitted'''',''''appeal.updated'''',''''assessment.funding.requested'''',''''assessment.funding.approved'''') AND NEW.adapter_key <> ''''resend'''') OR\\\\\\\\n     (delivery.delivery_type = ''''platform.foundation.email'''' AND NEW.adapter_key <> ''''local_test'''') THEN\\\\\\\\n   RAISE EXCEPTION ''''Email adapter does not match its fixed delivery type'''' USING ERRCODE=''''23514'''';\\\\\\\\n  END IF;\\\\\\\\n  RETURN NEW;\\\\\\\\nEND;\\\\\\\\n$function$\\\\\\\\n"}, {"kind": "function", "reference": "platform_email_attempt_guard_update()", "definition": "CREATE OR REPLACE FUNCTION public.platform_email_attempt_guard_update()\\\\\\\\n RETU